<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.mecanica</groupId>
	<artifactId>oficina-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>   <!--Este POM só coordena, não gera JAR -->
	
	<modules>
		<module>oficina-domain</module>
		<module>oficina-application</module>
        <module>oficina-adapters</module>
        <module>oficina-infrastructure</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<aws-sdk.version>2.57.11</aws-sdk.version>
		<!-- SonarCloud (análise no CI, ver .github/workflows/maven.yml) -->
		<sonar.organization>grupopostech-fiap</sonar.organization>
		<sonar.projectKey>GrupoPosTech-FIAP_oficina-app-api</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<!-- todos os módulos usam o relatório agregado: os testes de integração cobrem domínio e adapters -->
		<sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/oficina-infrastructure/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.coverage.exclusions>**/config/DevDataLoader.java,**/OficinaApiApplication.java</sonar.coverage.exclusions>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- AWS SDK v2: SNS/SQS da mensageria da Saga (ADR 005) -->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>	

    <build>
        <!-- JaCoCo em todos os módulos: cada um mede os próprios testes e o oficina-infrastructure
             junta tudo no relatório agregado que vai para o SonarCloud -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!-- jacoco fica aqui para todos os módulos herdarem -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.14</version>
                    <executions>
                        <execution>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>prepare-package</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.46</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
  	</build>
</project>
